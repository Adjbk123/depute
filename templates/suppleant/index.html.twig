{% extends 'base.html.twig' %}

{% block title %}Suppleant index{% endblock %}
{% block breadcrumb %}{% endblock %}


{% block bouton %}
    <a href="{{ path('app_register') }}" class="btn btn-primary d-none d-sm-inline-flex">
        <em class="icon ni ni-plus"></em>
        <span>Nouvel ajout</span>
    </a>
    <a href="{{ path('app_register') }}"  class="btn btn-icon btn-primary d-inline-flex d-sm-none">
        <em class="icon ni ni-plus"></em>
    </a>
{% endblock %}
{% block body %}
    <h1>Suppleant index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prenoms</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for suppleant in suppleants %}
            <tr>
                <td>{{ suppleant.id }}</td>
                <td>{{ suppleant.nom }}</td>
                <td>{{ suppleant.prenoms }}</td>
                <td>
                    <a href="{{ path('app_suppleant_show', {'id': suppleant.id}) }}">show</a>
                    <a href="{{ path('app_suppleant_edit', {'id': suppleant.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_suppleant_new') }}">Create new</a>
{% endblock %}
