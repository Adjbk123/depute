{% extends 'base.html.twig' %}

{% block title %}Député{% endblock %}
{% block breadcrumb %}{% endblock %}


{% block bouton %}
    <a href="{{ path('app_register') }}" class="btn btn-primary d-none d-sm-inline-flex">
        <em class="icon ni ni-plus"></em>
        <span>Nouvel ajout</span>
    </a>
    <a href="{{ path('app_register') }}"  class="btn btn-icon btn-primary d-inline-flex d-sm-none">
        <em class="icon ni ni-plus"></em>
    </a>
{% endblock %}
{% block body %}


    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ depute.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ depute.nom }}</td>
            </tr>
            <tr>
                <th>Prenoms</th>
                <td>{{ depute.prenoms }}</td>
            </tr>
            <tr>
                <th>DateNaissance</th>
                <td>{{ depute.dateNaissance ? depute.dateNaissance|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>LieuNaissance</th>
                <td>{{ depute.lieuNaissance }}</td>
            </tr>
            <tr>
                <th>Profession</th>
                <td>{{ depute.profession }}</td>
            </tr>
            <tr>
                <th>Biographie</th>
                <td>{{ depute.biographie }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_depute_index') }}">back to list</a>

    <a href="{{ path('app_depute_edit', {'id': depute.id}) }}">edit</a>

    {{ include('depute/_delete_form.html.twig') }}
{% endblock %}
