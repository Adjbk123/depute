{% extends 'base.html.twig' %}

{% block title %}Liste des comptes utilisateurs{% endblock %}
{% block breadcrumb %}{% endblock %}


{% block bouton %}
    <a href="{{ path('app_register') }}" class="btn btn-primary d-none d-sm-inline-flex">
        <em class="icon ni ni-plus"></em>
        <span>Nouvel ajout</span>
    </a>
    <a href="{{ path('app_register') }}"  class="btn btn-icon btn-primary d-inline-flex d-sm-none">
        <em class="icon ni ni-plus"></em>
    </a>
{% endblock %}


{% block body %}
    <table class="table datatable-init-export">
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Prénoms</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.nom }}</td>
                <td>{{ user.prenoms }}</td>
                <td>{{ user.email }}</td>
                <td>
                    <a class="btn btn-secondary btn-sm me-2 rounded-pill" href="{{ path('app_user_show', {'id': user.id}) }}"><i class="fa fa-eye"></i></a>
                    <a class="btn btn-primary btn-sm rounded-pill" href="{{ path('app_user_edit', {'id': user.id}) }}"><i class="fa fa-edit"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
