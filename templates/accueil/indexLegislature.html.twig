{% extends 'baseLanding.html.twig' %}

{% block title %}
Liste des deputés de la {{ legislatureAffichee.libelle }}  législature
{% endblock %}

{% block header %}

    <div class="header-content is-light">
        <div class="container">
            <div class="row flex-row-reverse justify-content-center text-center g-gs">
                <div class="col-lg-6 col-md-7 py-4"> <!-- Réduction de la marge top et bottom -->
                    <div class="header-caption py-4"> <!-- Réduction de la marge top et bottom -->
                        <h1 class="header-title m-0"> <!-- Suppression des marges autour du titre -->
                            Liste des députés de la {{ legislatureAffichee.libelle }} législature
                        </h1>
                    </div><!-- .header-caption -->
                </div><!-- .col -->
            </div><!-- .row -->
        </div><!-- .container -->
    </div><!-- .header-content -->

{% endblock %}



{% block body %}

    <div class="row justify-content-center text-center">
        <div class="col-sm-7 col-md-10 col-9">
            <div class="section-head">

            </div><!-- .section-head -->
        </div><!-- .col -->
    </div><!-- .row -->

    {% for groupeParlementaire, mandats in mandatsParGroupes %}

        <div  class="mb-5">


            <h4></h4>
            <div class="row justify-content-center text-center">
                <div class="col-sm-7 col-md-12 col-9">
                    <div class="section-head">
                        <h3 class="title bg-primary text-white p-3 rounded-3">{{ groupeParlementaire }}</h3>
                    </div><!-- .section-head -->
                </div><!-- .col -->
            </div><!-- .row -->

            <table class="table myTable table-bordered table-hover">
                <thead>
                <tr>
                    <th>Député</th>
                    <th>Circonscription </th>
                    <th>Date de naissance</th>
                    <th>Lieu de naissance</th>
                    <th>Parti Politique</th>
                </tr>
                </thead>
                <tbody>
                {% for mandat in mandats %}
                    <tr>
                        <td>{{ mandat.depute.prenoms }} {{ mandat.depute.nom }}</td>
                        <td>{{ mandat.depute.circonscription.libelle }} </td>
                        <td>{{ mandat.depute.dateNaissance}} </td>
                        <td>{{ mandat.depute.lieuNaissance}} </td>
                        <td>{{ mandat.partiPolitique.nom }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">Aucun enregistrement trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endfor %}



{% endblock %}
