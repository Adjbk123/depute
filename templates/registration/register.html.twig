{% extends 'base.html.twig' %}

{% block title %}Ajout d'un compte {% endblock %}
{% block breadcrumb %}{% endblock %}
{% block bouton %}

    <a href="{{ path('app_user_index') }}" class="btn btn-primary d-none d-sm-inline-flex">
        <em class="icon ni ni-arrow-left"></em>
        <span>Retour</span>
    </a>
    <a href="{{ path('app_user_index') }}"  class="btn btn-icon btn-primary d-inline-flex d-sm-none">
        <em class="icon ni ni-arrow-left"></em>
